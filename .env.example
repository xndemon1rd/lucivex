# ---- Browser-side (public; baked into the build) ----
# Leave empty to call same-origin /api (Vite dev proxy locally, the Vercel
# proxy function in production). Or set the public URL of your deployed
# backend, e.g. https://your-api.example.com  (then add this site to the
# backend's CORS_ORIGIN).
VITE_API_BASE_URL=

# Optional: comma-separated category types shown on the Browse page.
# Must match what GET /api/category/{type} supports. Default: series,movies,anime,cartoon
VITE_CATEGORY_TYPES=

# ---- Development only (used by vite.config.ts, never shipped to the browser) ----
DEV_API_TARGET=http://localhost:3000
DEV_API_ORIGIN=https://watchanimeworld.one

# ---- Server-side, for the Vercel proxy function (set in the Vercel dashboard) ----
# Public URL of your deployed backend (no trailing slash).
UPSTREAM_API_URL=
# Origin the backend currently accepts (its CORS_ORIGIN value). Optional.
UPSTREAM_ORIGIN=
